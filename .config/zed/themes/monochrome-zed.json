{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "DevPro Zed",
  "author": "Anjal",
  "themes": [
    {
      "name": "DevPro Zed",
      "appearance": "dark",
      "style": {
        "border": "#00000000",
        "panel.border": "#2c2c2c",
        "panel.focused_border": "#2c2c2c",
        "pane.focused_border": "#00000000",
        "scrollbar.track.border": "#00000000",
        "status_bar.border": "#00000000",
        "title_bar.border": "#00000000",

        "created": "#A4BE8C",
        "modified": "#ebcb8b",
        "deleted": "#bf616a",
        "ignored": "#4C566A",

        "background": "#1e1e28",
        "editor.background": "#1e1e28",

        "panel.background": "#1a1a20",
        "assistant.background": "#151826",
        "toolbar.background": "#1a1a20",
        "status_bar.background": "#1a1a20",
        "title_bar.background": "#1a1a20",

        "tab_bar.background": "#1e1e28",
        "tab.inactive_background": "#1e1e28",
