        "terminal.ansi.red": "#bf616a",
        "terminal.ansi.white": "#e5e9f0",
        "terminal.ansi.yellow": "#ebcb8b",

        "players": [{ "cursor": "#ebcb8b", "selection": "#61616150" }],

        "syntax": {
          "attribute": { "color": "#78dce8" },
          "boolean": { "color": "#ff6188" },
          "comment": { "color": "#7f848e", "font_style": "italic" },
          "comment.doc": { "color": "#8a9c9e", "font_style": "italic" },
          "constant": { "color": "#ff6188" },
          "constant.builtin": { "color": "#ff6188" },
          "constructor": { "color": "#78dce8" },
          "embedded": { "color": "#f6c177" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 800 },
          "enum": { "color": "#78dce8" },
          "enum.variant": { "color": "#f6c177" },
          "error": { "color": "#bf616a" },
          "function": { "color": "#78dce8" },
          "function.builtin": { "color": "#78dce8" },
          "function.method": { "color": "#78dce8" },
          "keyword": { "color": "#fc9867", "font_weight": 700 },
          "keyword.control": { "color": "#fc9867", "font_weight": 700 },
          "keyword.operator": { "color": "#fc9867" },
          "label": { "color": "#ebcb8b" },
          "link_uri": { "color": "#a3be8c", "underline": true },
          "number": { "color": "#f6c177" },
          "operator": { "color": "#fc9867" },
          "property": { "color": "#78dce8" },
          "punctuation": { "color": "#e6e6e6" },
          "punctuation.bracket": { "color": "#e6e6e6" },
          "punctuation.delimiter": { "color": "#e6e6e6" },
          "string": { "color": "#a9dc76" },
          "string.escape": { "color": "#ffd866" },
          "string.regex": { "color": "#ffd866" },
          "string.special": { "color": "#ffd866" },
          "tag": { "color": "#fc9867" },
          "title": { "color": "#78dce8", "font_weight": 700 },
          "type": { "color": "#78dce8" },
          "type.builtin": { "color": "#78dce8" },
          "type.parameter": { "color": "#f6c177" },
          "variable": { "color": "#e6e6e6" },
          "variable.builtin": { "color": "#ff6188" },
          "variable.special": { "color": "#ff6188" },
          "warning": { "color": "#ebcb8b" }
        }
      }
    },

