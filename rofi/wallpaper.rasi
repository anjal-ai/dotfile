/*
 * wallpaper.rasi — icon-grid wallpaper picker, scrollable
 */
* {
    bg0:        #1a1a1e;
    bg1:        #222228;
    accent:     #6b7fd4;
    accent-dim: #2a2f60;
    fg0:        #c8c8d8;
    fg1:        #666680;
    border-col: #33334a;
    background-color: transparent;
    text-color:       @fg0;
    font:             "JetBrainsMono Nerd Font 9";
}

window {
    background-color: @bg0;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    12px;
    padding:          12px;
    width:            700px;
    height:           540px;
}

mainbox {
    background-color: transparent;
    spacing:          10px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          7px 12px;
    spacing:          8px;
    children:         [ entry ];
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "Search wallpapers…";
    placeholder-color: @fg1;
}

listview {
    background-color: transparent;
    columns:          3;
    lines:            2;
    spacing:          10px;
    scrollbar:        true;
    cycle:            false;
    dynamic:          true;
    fixed-height:     true;
    layout:           vertical;
}

element {
    background-color: @bg1;
    border:           2px solid;
    border-color:     transparent;
    border-radius:    8px;
    padding:          4px;
    orientation:      vertical;
    spacing:          4px;
    cursor:           pointer;
}

element selected {
    background-color: @accent-dim;
    border-color:     @accent;
}

element-icon {
    background-color: transparent;
    /* explicit size makes rofi actually render the icon */
    size:             200px;
    border-radius:    6px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       @fg1;
    font:             "JetBrainsMono Nerd Font 7";
    horizontal-align: 0.5;
    padding:          2px 0 0 0;
}

scrollbar {
    background-color: @bg1;
    handle-color:     @accent;
    handle-width:     4px;
    border:           0px;
    border-radius:    4px;
    width:            6px;
}

